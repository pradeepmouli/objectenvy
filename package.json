{
  "name": "objectenvy-workspace",
  "version": "1.0.0",
  "description": "ObjectEnvy monorepo - strongly-typed environment configuration for TypeScript projects",
  "keywords": [
    "config",
    "configuration",
    "env",
    "environment",
    "typescript",
    "type-safe",
    "zod",
    "nested",
    "camelcase",
    "dotenv"
  ],
  "private": true,
  "license": "MIT",
  "homepage": "https://pradeepmouli.github.io/objectenvy/",
  "bugs": {
    "url": "https://github.com/pradeepmouli/objectenvy/issues"
  },
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm -r --parallel dev",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "lint": "pnpm -r lint",
    "format": "pnpm -r format",
    "format:check": "pnpm -r format:check",
    "type-check": "pnpm -r type-check",
    "clean": "pnpm -r clean && rm -rf dist coverage",
    "docs:dev": "pnpm --filter @objectenvy/docs dev",
    "docs:build": "pnpm --filter @objectenvy/docs build",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "pnpm build && pnpm -r --filter=objectenvy --filter=objectenvy-cli publish",
    "changeset:version": "changeset version",
    "changeset:publish": "pnpm run build && changeset publish"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@vitest/coverage-v8": "^4.1.7",
    "lint-staged": "^17.5.1",
    "oxfmt": "^0.68.0",
    "oxlint": "^1.83.0",
    "tslib": "^2.8.1",
    "tsx": "^4.22.3",
    "type-fest": "^5.8.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.7",
    "zod": "^4.4.3"
  },
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=11.0.0"
  },
  "packageManager": "pnpm@11.1.3",
  "author": "Pradeep Mouli <pmouli@mac.com> (https://github.com/pradeepmouli)"
}
